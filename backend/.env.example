# Copy to backend/.env (loaded automatically when you run from the backend folder)
DB_URL=jdbc:postgresql://localhost:5432/engish
DB_USER=engish
DB_PASSWORD=engish

# Ollama (local LLM). Pull the model first:  ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.7

# Origins allowed to call the API (the static frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8080

# Flyway migrations use the owner
FLYWAY_USER=engish
FLYWAY_PASSWORD=engish

OLLAMA_MAX_OUTPUT_TOKENS=1600
OLLAMA_MAX_CONCURRENT=2